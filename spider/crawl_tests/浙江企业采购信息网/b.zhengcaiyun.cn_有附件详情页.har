            "text": "{\"success\":true,\"result\":{\"data\":{\"title\":\"浙江智拓项目管理有限公司关于2026年诸暨市童颐康养服务中心专项债存款专户招标项目的公开招标公告\",\"htmlTitle\":null,\"isCustomTitle\":0,\"articleId\":\"1TpiaRsEMXGtElZpCVUa4A==\",\"siteId\":103,\"author\":\"浙江智拓项目管理有限公司\",\"projectCode\":\"浙江智拓2026-07-19\",\"projectName\":\"2026年诸暨市童颐康养服务中心专项债存款专户招标项目\",\"publishDate\":1784882940000,\"documentNo\":null,\"redHeadFile\":null,\"rankCategoryName\":null,\"belongingName\":\"\",\"implementationDate\":null,\"announcementType\":3001,\"announcementId\":\"m+tKGUHsssCBWszHiVowGoTwhJI3yMqKEmeFXDD+K4I=\",\"isGovPurchase\":false,\"districtCode\":\"900604\",\"isGovernmentPurchaseService\":null,\"categoryNames\":[\"公示公告\",\"采购公告\",\"公开招标公告\"],\"isShowAttachment\":false,\"subscriptionUrl\":null,\"supportEnglish\":null,\"englishTitle\":null,\"announcementLinkDtoList\":[{\"articleId\":\"1TpiaRsEMXGtElZpCVUa4A==\",\"type\":null,\"typeName\":\"采购公告\",\"isExist\":true,\"isCurrent\":true,\"url\":null,\"publishDate\":\"2026-07-24\",\"order\":2,\"publishDateTime\":1784882940000},{\"articleId\":null,\"type\":null,\"typeName\":\"更正公告\",\"isExist\":false,\"isCurrent\":false,\"url\":null,\"publishDate\":null,\"order\":3,\"publishDateTime\":null},{\"articleId\":null,\"type\":null,\"typeName\":\"结果公告\",\"isExist\":false,\"isCurrent\":false,\"url\":null,\"publishDate\":null,\"order\":4,\"publishDateTime\":null},{\"articleId\":null,\"type\":null,\"typeName\":\"合同公告\",\"isExist\":false,\"isCurrent\":false,\"url\":null,\"publishDate\":null,\"order\":5,\"publishDateTime\":null}],\"content\":\"<style id=\\\"fixTableStyle\\\" type=\\\"text/css\\\">th,td {border:1px solid #DDD;padding: 5px 10px;}</style>\\n<table cellspacing=\\\"0\\\" style=\\\"width:100%;border-collapse:collapse;\\\"><tbody><tr style=\\\"height:107px\\\" class=\\\"firstRow\\\"><td width=\\\"619\\\" valign=\\\"top\\\" style=\\\"padding: 0px 7px; border-width: 1px; border-color: windowtext;\\\"><p style=\\\"margin-top:0;margin-bottom:0;line-height:120%\\\"><span style=\\\"font-family:宋体;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">项目概况</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;text-indent:32px;line-height:120%\\\"><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px\\\">2026年诸暨市童颐康养服务中心专项债存款专户招标项目</span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px\\\"></span></span><span style=\\\"font-family:宋体;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">招标项目的潜在投标人应在</span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">乐采云平台（</span><span style=\\\"font-family:宋体\\\">https://www.lecaiyun.com/）</span></span></span><span style=\\\"font-family:宋体;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">获取（下载）招标文件，并于</span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">2026年8月10日</span></span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">9：00</span></span></span><span style=\\\"font-family:宋体;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">（北京时间）前递交（上传）投标文件。</span></span></p></td></tr></tbody></table><h2 style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">一、项目基本情况</span></strong></h2><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">项目名称</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">：</span><span style=\\\"font-family:宋体\\\">2026年诸暨市童颐康养服务中心专项债存款专户招标项目</span></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">项目编号：</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">浙江智拓</span><span style=\\\"font-family:宋体\\\">2026-07-19</span></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">采购组织类型：</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">采购</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">委托代</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">理</span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">项目内容及规模：</span></p><table cellspacing=\\\"0\\\" style=\\\"width:100%;border-collapse:collapse;\\\"><tbody><tr style=\\\"height:38px\\\" class=\\\"firstRow\\\"><td width=\\\"253\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-width: 1px; border-color: windowtext;\\\"><p style=\\\"text-align:center;line-height:125%\\\"><strong><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">招标内容</span></strong></p></td><td width=\\\"89\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-width: 1px; border-color: windowtext;\\\"><p style=\\\"text-align:center;line-height:125%\\\"><strong><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">银行数量</span></strong></p></td><td width=\\\"220\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-width: 1px; border-color: windowtext;\\\"><p style=\\\"text-align:center;line-height:125%\\\"><strong><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">资金存放规模</span></strong></p></td></tr><tr style=\\\"height:51px\\\"><td width=\\\"253\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-left-width: 1px; border-left-color: windowtext; border-right-width: 1px; border-right-color: windowtext; border-top: none; border-bottom-width: 1px; border-bottom-color: windowtext;\\\"><p style=\\\";text-autospace:none;page-break-after:avoid;text-align:center;line-height:125%\\\"><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">2026年童颐康养专项债存款专户招标项目</span></p></td><td width=\\\"89\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-left-width: 1px; border-left-color: windowtext; border-right-width: 1px; border-right-color: windowtext; border-top: none; border-bottom-width: 1px; border-bottom-color: windowtext;\\\"><p style=\\\";text-autospace:none;page-break-after:avoid;text-align:center;line-height:125%\\\"><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">1家</span></p></td><td width=\\\"220\\\" valign=\\\"center\\\" style=\\\"padding: 0px 7px; border-left-width: 1px; border-left-color: windowtext; border-right-width: 1px; border-right-color: windowtext; border-top: none; border-bottom-width: 1px; border-bottom-color: windowtext;\\\"><p style=\\\";text-autospace:none;page-break-after:avoid;text-align:center;line-height:125%\\\"><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">不超过</span><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">2.2亿元</span></p><p style=\\\";text-autospace:none;page-break-after:avoid;text-align:center;line-height:125%\\\"><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">（以实际到位资金为准）</span></p></td></tr></tbody></table><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">评标办法：综合评分法</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">二</span><span style=\\\"font-family:宋体\\\">、投标人（供应商）资格要求</span></span></strong></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\">1.符合下列要求：</span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">1）具有独立承担民事责任的能力；</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">2）具有良好的商业信誉和健全的财务会计制度；</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">3）具有履行合同所必需的设备和专业技术能力；</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">4）有依法缴纳税收和社会保障资金的良好记录；</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">5）参加采购活动前三年内，在经营活动中没有重大违法记录；</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">（</span><span style=\\\"font-family:宋体\\\">6）法律、行政法规规定的其他条件。</span></span></p><p style=\\\"text-indent:32px;text-autospace:ideograph-numeric;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">2.未被“信用中国”（www.creditchina.gov.cn）、中国政府采购（www.ccgp.gov.cn）列入失信被执行人、重大税收违法失信主体、政府采购严重违法失信行为记录名单。</span></span></p><p style=\\\"text-indent:32px;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">3.人民银行上年度综合评价B级以上（新设银行第一年不受此限）；</span></span></p><p style=\\\"text-indent:32px;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">4.依法开展经营活动，近3年内在经营活动中无重大违法违规记录及重大违约事件。</span></span></p><p style=\\\"text-indent:32px;line-height:125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">5.本项目</span></span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">不</span></span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">接受联合体投标。</span></span></p><h2 style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">三、获取招标文件</span></strong></h2><p style=\\\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">时间：</span><span style=\\\"font-family:宋体\\\">/至</span></span><span style=\\\";font-family:宋体;font-size:16px\\\">2026年8月10日</span><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">，每天上午</span><span style=\\\"font-family:宋体\\\">00:00至12:00，下午12:00至23:59（北京时间）</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">地点：乐采云平台（</span><span style=\\\"font-family:宋体\\\">https://www.lecaiyun.com/）</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">方式：潜在供应商登录乐采云平台，在线申请获取招标文件。进入</span><span style=\\\"font-family:宋体\\\">“项目采购”应用，在获取招标文件菜单中选择项目，申请获取招标文件（仅需浏览招标文件的供应商可点击“游客，浏览招标文件”直接下载招标文件浏览）。招标文件发布截止时间之后有潜在供应商提出要求获取招标文件的，允许获取。</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;font-size:16px\\\">售价：免费。</span></p><h2 style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">四、提交投标文件</span><span style=\\\"font-family:宋体\\\">截止时间、开标时间和地点</span></span></strong></h2><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">提交投标文件截止时间：</span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">2026年8月10日</span></span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">9：00</span></span></span><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">（北京时间）</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">投标地点（网址）：</span></span><span style=\\\";font-family:宋体;font-size:16px\\\">投标人应于</span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">2026年8月10日</span></span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">9：00</span></span></span><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">之前将电子投标文件上传到</span><span style=\\\"font-family:宋体\\\">“</span></span><span style=\\\";font-family:宋体;font-size:16px\\\">乐采云</span><span style=\\\";font-family:宋体;font-size:16px\\\">”平台，逾期上传不予接收。</span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">开标时间：</span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">2026年8月10日</span></span></span><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;font-size: 16px;background: #FFFFFF\\\"><span style=\\\"font-family:宋体\\\">9：00</span></span></span><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">（北京时间）</span></span></p><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">开标地点（网址）：</span></span><span style=\\\";font-family:宋体;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">浙江智拓项目管理有限公司三楼评标室（</span><span style=\\\"font-family:宋体\\\">1）</span></span></p><h2 style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">五、公告期限</span></strong></h2><p style=\\\"margin-left:0;text-indent:32px;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">自本公告发布之日起</span><span style=\\\"font-family:宋体\\\">5个工作日。</span></span></p><h2 style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">六、其他补充事宜</span></strong></h2><p style=\\\"margin-top:0;margin-bottom:0;margin-left:0;text-indent:32px;line-height:125%\\\"><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">1</span></span><span style=\\\";font-family:宋体;background:#FFFFFF\\\"><span style=\\\"font-family:宋体\\\">.</span></span><span style=\\\";font-family:宋体;font-size:16px\\\">供应商认为招标文件使自己的权益受到损害的，可以自获取招标文件之日或者招标文件公告期限届满之日（公告期限届满后获取招标文件的，以公告期限届满之日为准）起七个工作日内，以书面形式向采购人和采购代理机构提出质疑。</span><span style=\\\";font-family:宋体;font-size:16px\\\">采购代理机构与采购人研究后，对认为有必要回答的问题，招标人将在</span><span style=\\\";font-family:宋体;font-size:16px\\\">开标</span><span style=\\\";font-family:宋体;font-size:16px\\\">前将答疑内容以网上发布公告的形式通知所有投标人，投标人自行在网上查阅、下载答疑回复答疑内容是招标文件的组成</span><span style=\\\";font-family:宋体;font-size:16px\\\">部分</span><span style=\\\";font-family:宋体;font-size:16px\\\">。</span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">2.其他事项：详见招标文件。</span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">七、投标保证金</span></strong></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">本项目</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">免收</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">投标保证金。</span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:ideograph-numeric;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">八、其他注意事项</span></strong></p><p style=\\\"margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">投标人应于开标时间前按照电子投标要求将电子加密标书上传到</span><span style=\\\"font-family:宋体\\\">“</span></span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">”平台，逾期或未上传成功的将导致无法投标或投标无</span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">效。</span></strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">备注：为确保采购项目顺利实施，避免因</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">上电子投标文件解密失败导致投标方投标无效，投标方可在开标时间前将在</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">平台上最后生成的具备电子签章的备份加密投标文件（文件名后缀为备份文件四字的首字母）以电子邮件方式传送至</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">浙江智拓项目管理有限公司邮箱</span><span style=\\\"font-family:宋体\\\">3314994607@qq.com</span></span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">，传送的备份电子投标文件需打包压缩并加密，加密密码由投标方自行保管，如</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">上电子投标文件出现解密失败情况（开标后</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">30分钟</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">内进行解密），投标方可按照自身意愿确认是否同意提供加密密码解密传送至</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">浙江智拓项目管理有限公司</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">邮箱的备份文件，并以备份文件作为替代电子投标文件，如投标方未按照规定时间前按要求提供有效备份文件，同时</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">上投标文件解密失败的，将导致投标无效。</span></p><p style=\\\"margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\"text-decoration:underline;\\\"><span style=\\\"font-family: 宋体;line-height: 120%;font-size: 16px\\\">投标方无需在开标当天到达开标现场对电子投标进行解密，可在公司办公场地在规定时间内对电子投标文件进行解密。</span></span></strong></p><p style=\\\"margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">开标时间后</span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">30分钟</span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">内供应商可以登录</span><span style=\\\"font-family:宋体\\\">“</span></span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">乐采云</span></strong><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">”平台，用“项目采购-开标评标”功能进行解密投标文件。若供应商在规定时间内无法解密或解密失败，将导致投标无效或失败。投标人制作电子投标文件和解密投标文件的需为同一把CA。同时为保障项目开标的连贯性、减少电子投标的意外事件，制作电子投标人员与开标人员最好为同一人，预留同一手机号码。</span></strong></p><p style=\\\"margin-left:0;text-indent:32px;line-height:120%\\\"><strong><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">九、业务咨询</span></strong></p><p style=\\\"text-indent: 32px;line-height: 125%\\\"><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\">招标单位联系人：</span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\">滕子京</span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">工作</span></span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\">电话：</span><span style=\\\";font-family:仿宋;line-height:125%;font-size:16px\\\">15968169794</span></p><p style=\\\"text-indent:32px;line-height:125%\\\"><span style=\\\"font-family: 宋体;line-height: 125%;font-size: 16px\\\">招标单位地址：</span><span style=\\\";font-family:宋体;line-height:125%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">诸暨市艮塔西路</span><span style=\\\"font-family:宋体\\\">130号</span></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:none;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:none;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">代理机构联系人：</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">石露菲</span> <span style=\\\"font-family:宋体\\\">金德华</span></span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"></span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">工作</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">电话：</span><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\">19941068622</span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:none;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"><span style=\\\"font-family:宋体\\\">代理机构单位地址：诸暨市艮塔东路</span><span style=\\\"font-family:宋体\\\">176号</span></span></p><p style=\\\"margin-left:0;text-indent:32px;text-autospace:none;line-height:120%\\\"><span style=\\\";font-family:宋体;line-height:120%;font-size:16px\\\"></span></p><p style=\\\"margin-left:0;text-indent:28px;text-autospace:none;line-height:120%\\\"><span style=\\\";font-family:宋体;font-size:14px\\\"><span style=\\\"font-family:宋体\\\">若对项目采购电子交易系统操作有疑问，可登录乐采云平台（</span><span style=\\\"font-family:宋体\\\">https://www.lecaiyun.com/），点击右侧咨询小采，获取采小蜜智能服务管家帮助，或拨打乐采云服务热线95763获取热线服务帮助。</span></span></p><p><br/></p><p style='font-size' class='fjxx'>附件信息：</p><ul class=\\\"fjxx\\\" style=\\\"font-size: 16px;margin-left: 38px;color: #0065ef;list-style-type: none;\\\"><li><p style=\\\"display:inline-block\\\"><a href=\\\"https://zcy-gov-open-doc.oss-cn-north-2-gov-1.aliyuncs.com/1023FP/lcy/900099/10007107950/20267/06c283bc-cda8-4b88-8abc-1397803cadda.doc\\\">（电子标）招标文件-2026年诸暨市童颐康养服务中心专项债存款专户招标项目.doc</a></p><p style=\\\"display:inline-block;margin-left:20px\\\">318.5K</p></li></ul><ul class=\\\"fjxx\\\" style=\\\"font-size: 16px;margin-left: 38px;color: #0065ef;list-style-type: none;\\\"><li><p style=\\\"display:inline-block\\\"><a href=\\\"https://zcy-gov-open-doc.oss-cn-north-2-gov-1.aliyuncs.com/1024FPA/lcy/900099/10007107950/20267/ee40c193-ae94-444b-8723-946e0e529bcd.xlsx\\\">附件 - 融资明细表.xlsx</a></p><p style=\\\"display:inline-block;margin-left:20px\\\">23.5K</p></li></ul>\",\"click\":42,\"attachmentList\":null,\"attachmentVO\":{\"domain\":\"https://zcy-gov-open-doc.oss-cn-north-2-gov-1.aliyuncs.com/\",\"attachments\":[{\"fileId\":\"1023FP/lcy/900099/10007107950/20267/06c283bc-cda8-4b88-8abc-1397803cadda.doc\",\"name\":\"（电子标）招标文件-2026年诸暨市童颐康养服务中心专项债存款专户招标项目.doc\",\"isShow\":true},{\"fileId\":\"1024FPA/lcy/900099/10007107950/20267/ee40c193-ae94-444b-8723-946e0e529bcd.xlsx\",\"name\":\"附件 - 融资明细表.xlsx\",\"isShow\":true}],\"acquirePurFileDetailUrl\":\"https://www.lecaiyun.com/bid-enroll/acquirepurfile/launch/67e47af9c220eefe\"},\"dynamicNodeLinkList\":null,\"expireFlag\":0,\"expiredAt\":\"2026-07-31T15:59:59.000+00:00\",\"challengeLink\":null,\"projectProcurementFlag\":null,\"announcementShowVo\":null,\"newLinkNodeList\":null}},\"error\":null}"
